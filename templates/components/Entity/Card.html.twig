<div {{ attributes }}>
    <h3>{{ computed.getMetadata().getEntityLabel(this.group) }}</h3>
    <table class="table table-hover">
        {% for name, metadata in computed.getMetadata().getPropertiesMetadata() %}
            {% set value = this.getPropertyValue(entity, metadata.name) %}
            {% if metadata.showIfEmpty(this.group) or (not metadata.showIfEmpty(this.group) and not (value.getValue() is empty)) %}
            <tr>
                <th style="text-wrap: nowrap;">{{ metadata.getLabel(this.group)|trans }}</th>
                <td class="w-100">{{ value|raw }}</td>
            </tr>
            {% endif %}
        {% endfor %}
    </table>
</div>